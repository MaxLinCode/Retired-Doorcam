<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- DETECTION SETTINGS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detection"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:paddingBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="0.5"
            android:valueFrom="0.3"
            android:valueTo="0.9"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Person detection confidence threshold"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- RECOGNITION SETTINGS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recognition"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:paddingBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="0.6"
            android:valueFrom="0.1"
            android:valueTo="0.9"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Identity match threshold (cosine similarity)"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visitor alerts"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:paddingBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Safe Identities (comma separated)"
            tools:ignore="HardcodedText">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editSafeIdentities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords|textNoSuggestions" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlertUnknown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert for unknown approaching people"
            tools:ignore="HardcodedText" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlertKnown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert for recognized people"
            tools:ignore="HardcodedText" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlertObjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert when a person may be carrying something"
            tools:ignore="HardcodedText" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlertKnownObjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert for carried objects even with a known person"
            tools:ignore="HardcodedText" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carried-object and parcel detection needs a compatible model and is currently unavailable."
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="HardcodedText" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Stairway detection area (left,top,right,bottom; 0–1)"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="HardcodedText" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editStairRoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0,0,1,1"
            android:inputType="text"
            tools:ignore="HardcodedText" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textSafeIdentitiesError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorError"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Incident timeout (seconds room must be empty)"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIncidentTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="15.0"
            android:valueFrom="5.0"
            android:valueTo="60.0"
            android:stepSize="5.0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Grace period (seconds before alert triggers)"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderGracePeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="9.0"
            android:valueFrom="3.0"
            android:valueTo="30.0"
            android:stepSize="3.0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:id="@+id/textTimingError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorError"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            android:text="Warning: Incident timeout must be longer than grace period."
            tools:ignore="HardcodedText" />

        <!-- CAMERA SETTINGS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:paddingBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTargetFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="3.0"
            android:valueFrom="1.0"
            android:valueTo="10.0"
            android:stepSize="1.0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target FPS"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="HardcodedText" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutResolution"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Resolution"
            tools:ignore="HardcodedText">

            <AutoCompleteTextView
                android:id="@+id/dropdownResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:entries="@array/resolution_options"
                tools:ignore="LabelFor" />

        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- NOTIFICATIONS SETTINGS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:paddingBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchTelegramAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Telegram alerts"
            tools:ignore="HardcodedText" />

        <!-- Hidden by default, shown when switch is ON -->
        <LinearLayout
            android:id="@+id/layoutTelegramConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Telegram Bot Token"
                tools:ignore="HardcodedText">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTelegramToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textVisiblePassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Telegram Chat ID"
                tools:ignore="HardcodedText">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTelegramChatId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textVisiblePassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonTestTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Telegram test"
                tools:ignore="HardcodedText" />
            <TextView
                android:id="@+id/textTelegramStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="Open your bot chat in Telegram and tap Start before testing."
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

